<Project>

  <!--
    Central Package Management (CPM). Every project at or below this directory declares
    PackageReference items WITHOUT a Version attribute; the effective version resolves
    from the PackageVersion entries below. Concrete, stable, net8.0-compatible versions
    are pinned (no floating 8.0.* ranges) because CPM prefers exact versions.

    Scope note: the sibling backend.Tests project lives outside this directory tree, so
    CPM does not apply to it; it keeps its own inline versions.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mediator -->

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />

    <!-- Structured logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- Metrics & tracing -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.12.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />

    <!-- Health checks -->
    <PackageVersion Include="AspNetCore.HealthChecks.Npgsql" Version="8.0.1" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="8.0.1" />

    <!-- Persistence (EF Core / PostgreSQL) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />

    <!-- Authentication -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />

    <!-- API / OpenAPI -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- Cache -->
    <PackageVersion Include="StackExchange.Redis" Version="2.13.1" />

    <!-- Password hashing -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Env loader (application.properties-style .env files for dev/VPS) -->
    <PackageVersion Include="DotNetEnv" Version="3.1.1" />

    <!-- Payments -->
    <PackageVersion Include="Razorpay" Version="3.3.2" />

    <!-- Excel parsing (admin bulk-import of interview questions) -->
    <PackageVersion Include="ClosedXML" Version="0.104.2" />

    <!-- S3-compatible object storage (Cloudflare R2 for student resume uploads) -->
    <PackageVersion Include="AWSSDK.S3" Version="3.7.403" />

    <!-- Architecture tests -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageVersion Include="CsCheck" Version="3.2.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
