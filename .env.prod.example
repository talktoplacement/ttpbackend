# -----------------------------------------------------------------------------
# Production environment for docker-compose.prod.yml (Hostinger VPS).
# Copy to `.env.prod` on the VPS and fill in real values. NEVER commit `.env.prod`.
# -----------------------------------------------------------------------------

# ── Supabase Postgres ────────────────────────────────────────────────────────
# Get these from Supabase Dashboard → Project Settings → Database → Connection Info
# Use the "Session pooler" values (port 5432 with the pooler host), NOT the
# transaction pooler (port 6543) — Npgsql prepared statements need session mode.
#
# Format:  aws-1-<region>.pooler.supabase.com
SUPABASE_HOST=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
# Note: the username has the project ref suffix, e.g. `postgres.abcdefghijklmnop`
SUPABASE_USER=postgres.YOUR_PROJECT_REF
SUPABASE_PASSWORD=your-supabase-db-password
JWT_ISSUER=careerplatform-api
JWT_AUDIENCE=authenticated
JWT_SECRET=change-me-openssl-rand-base64-48
FRONTEND_ORIGIN=https://ttpfrontend.vercel.app,localhost:3000,localhost:3001
FRONTEND_ORIGIN_PREVIEW=
FRONTEND_PREVIEW_SUFFIX=-yourteam.vercel.application

AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_ALWAYS_SECURE=true
AUTH_COOKIE_PARTITIONED=false
CODE_EXECUTION_PROVIDER=Piston
CODE_EXECUTION_BASE_URL=http://piston:2000

# ── Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@your-domain.com
BREVO_SENDER_NAME=CareerPlatform
BREVO_OTP_TEMPLATE_ID=
OTP_HASH_KEY=change-me-openssl-rand-base64-48

API_DOMAIN=api.your-domain.com
ACME_EMAIL=you@your-domain.com
API_HOST_PORT=8081

STORAGE_PROVIDER=Local


DATABASE_TRUST_SERVER_CERTIFICATE=false
DB_MAX_POOL_SIZE=15
API_MEM_LIMIT=1024m
API_CPUS=1.5
# Only used with `--profile sandbox`. Drop API_MEM_LIMIT to 768m first.
PISTON_MEM_LIMIT=768m
PISTON_CPUS=1.0
CGROUP_PARENT=careerplatform.slice
BUILD_CONTEXT=.
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_METRICS_ENABLED=false
OBSERVABILITY_OTLP_ENDPOINT=
