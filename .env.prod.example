# -----------------------------------------------------------------------------
# Production environment for docker-compose.prod.yml (Hostinger VPS).
# Copy to `.env.prod` on the VPS and fill in real values. NEVER commit `.env.prod`.
# -----------------------------------------------------------------------------

# ── Supabase Postgres ────────────────────────────────────────────────────────
# Get these from Supabase Dashboard → Project Settings → Database → Connection Info
# Use the "Session pooler" values (port 5432 with the pooler host), NOT the
# transaction pooler (port 6543) — Npgsql prepared statements need session mode.
#
# Format:  aws-1-<region>.pooler.supabase.com
SUPABASE_HOST=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
# Note: the username has the project ref suffix, e.g. `postgres.abcdefghijklmnop`
SUPABASE_USER=postgres.YOUR_PROJECT_REF
SUPABASE_PASSWORD=your-supabase-db-password
# Postgres schema this app owns. Leave as `public` only if the database belongs to
# this app alone. If the project is shared with another application, use a dedicated
# schema — six table names in schema.sql are generic (Transactions, Notifications,
# Certificates, Sections, SupportTickets, PlacementCompanies) and a collision is
# SILENT (CREATE TABLE IF NOT EXISTS skips it), after which the app binds to the
# foreign table and fails on its first query.
#
# Apply schema.sql into this schema before the app boots:
#   CREATE SCHEMA IF NOT EXISTS careerplatform;
#   SET search_path TO careerplatform;   -- then run backend/schema.sql
DATABASE_SCHEMA=careerplatform

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate the secret with: openssl rand -base64 48
JWT_ISSUER=https://api.your-domain.com
JWT_AUDIENCE=authenticated
JWT_SECRET=change-me-openssl-rand-base64-48

# ── Frontend origin (Vercel) — for CORS ─────────────────────────────────────
# Production Vercel URL. Must be https:// — plaintext origins are dropped outside
# Development because this policy grants credentials (the session cookie).
FRONTEND_ORIGIN=https://your-app.vercel.app
# One extra exact origin, if you want a specific preview URL to hit the prod API.
FRONTEND_ORIGIN_PREVIEW=
# Vercel gives every preview commit its own hostname
# (your-app-git-branch-yourteam.vercel.app), so exact origins cannot cover them.
# This allows any HTTPS origin whose HOST ends with the suffix. Use the
# team-scoped form — a bare `.vercel.app` would trust every app on that domain.
# Leave blank to allow the production origin only.
FRONTEND_PREVIEW_SUFFIX=-yourteam.vercel.app

# ── Session cookie ──────────────────────────────────────────────────────────
# Vercel and this API are different sites, so the cookie MUST be SameSite=None
# or the browser will not send it on cross-site fetches — login would succeed
# and every subsequent request would return 401. None requires Secure.
#
# Only change these if you move the frontend onto the same site as the API
# (e.g. behind one domain via a reverse proxy), in which case use Lax.
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_ALWAYS_SECURE=true
# CHIPS partitioning. Opt-in: gives the cookie a per-top-level-site jar. Safe to
# leave false; enable only after testing your browser matrix.
AUTH_COOKIE_PARTITIONED=false

# ── Code-execution sandbox (assessment coding questions) ────────────────────
# `Piston` runs the sandbox container defined in docker-compose.prod.yml.
# Set to `Disabled` to turn coding questions off — MCQ assessments still work,
# and the runner hides the Run button.
CODE_EXECUTION_PROVIDER=Piston
# Internal compose address. Point this at another host if you move the sandbox
# off this VPS (recommended if you hit memory pressure).
CODE_EXECUTION_BASE_URL=http://piston:2000

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── Brevo (ALL outbound email: OTP, password reset, admin/promo) ────────────
# One provider for every email the app sends. API key starts with `xkeysib-`.
# Get from Brevo dashboard → SMTP & API → API Keys.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender on your Brevo account (Senders & IPs → Senders).
BREVO_SENDER_EMAIL=noreply@your-domain.com
BREVO_SENDER_NAME=CareerPlatform
# Optional: numeric template id for OTP emails only. Leave blank to use the
# built-in HTML fallback. Non-OTP email (password reset, admin/promo) always
# uses the inline HTML the sending code composes.
BREVO_OTP_TEMPLATE_ID=

# ── OTP hashing ──────────────────────────────────────────────────────────────
# HMAC key used to hash stored OTP codes, so a database dump alone cannot be
# replayed into valid codes. Minimum 32 characters. REQUIRED — registration email
# verification fails without it.
#   openssl rand -base64 48
OTP_HASH_KEY=change-me-openssl-rand-base64-48

# ── Public hostname / TLS (only needed for the `edge` profile) ───────────────
# The API's own domain. Point an A record at the VPS IP BEFORE first start, or
# Let's Encrypt validation fails and Caddy retries with backoff.
API_DOMAIN=api.your-domain.com
# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@your-domain.com

# ── Host port ────────────────────────────────────────────────────────────────
# Bound on 127.0.0.1 only; the host's nginx proxies to it. 8080 is NOT usable on
# this VPS — another project's Java process already listens there. Verify before
# changing:  sudo ss -tlnp | grep -E ':(8081|8082)\s'
# Must match the `upstream` port in deploy/nginx/careerplatform-api.conf.
API_HOST_PORT=8081

# ── File storage ─────────────────────────────────────────────────────────────
# `Local` writes uploaded resumes to the api_storage Docker volume (mounted at
# /app/storage). That volume is the only application state NOT in Supabase, so
# include it in your backups. Switch to `R2` and set the Storage__* bucket keys
# to move uploads off the VPS entirely.
STORAGE_PROVIDER=Local

# ── Database connection tuning ───────────────────────────────────────────────
# Leave false so the Supabase certificate is properly validated. Set true only if
# the container cannot chain their CA and you have accepted that trade-off.
DATABASE_TRUST_SERVER_CERTIFICATE=false
# Supabase caps concurrent pooler connections and each one costs memory on both
# ends. 15 is comfortable for this workload; raise only with evidence of waiting.
DB_MAX_POOL_SIZE=15

# ── Resource ceilings (the 2 GB budget) ─────────────────────────────────────
# Hard caps, not reservations. Docker OOM-kills the container that exceeds its
# limit, so a problem here cannot starve the other two projects on the box.
#
#   Without the sandbox:  api 1024m + caddy 96m            = ~1.1 GB
#   With the sandbox:     api  768m + caddy 96m + 768m     = ~1.6 GB
API_MEM_LIMIT=1024m
API_CPUS=1.5

# Only used with `--profile sandbox`. Drop API_MEM_LIMIT to 768m first.
PISTON_MEM_LIMIT=768m
PISTON_CPUS=1.0

# ── cgroup slice (the hard 2 GB reservation) ─────────────────────────────────
# Every container joins this systemd slice, which caps the project AS A GROUP at
# 2 GB — see deploy/systemd/careerplatform.slice. Install the slice before the
# first `up`, or Docker fails with "cgroup parent not found".
#
# Requires cgroup v2 + Docker's systemd cgroup driver. Check both:
#   stat -fc %T /sys/fs/cgroup       # want cgroup2fs
#   docker info | grep -i cgroup     # want Driver: systemd, Version: 2
#
# If your Docker uses the cgroupfs driver instead, set this to empty to fall back
# to per-container limits only (weaker: no aggregate guarantee).
CGROUP_PARENT=careerplatform.slice
