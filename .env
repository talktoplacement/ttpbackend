# Dev-local .env — gitignored. Do not commit. Copy from .env.example and fill.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5215

DATABASE_URL=postgresql://postgres.bzvtnpjdilzpwjoojuuk:Prince@#135@135@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Local dev opts into trusting the Supabase pooler cert. Secure-by-default is OFF; do NOT set
# this in production unless the DB's CA is intentionally not in the trust store.
DATABASE_TRUST_SERVER_CERTIFICATE=true
# This Supabase project also hosts an unrelated application in `public`, and six table
# names collide (Transactions, Notifications, Certificates, Sections, SupportTickets,
# PlacementCompanies) with a different shape. Confine this app to its own schema.
DATABASE_SCHEMA=careerplatform
ConnectionStrings__Redis=disabled

Jwt__Issuer=https://dev-local.placementpro.local/auth
Jwt__Audience=authenticated
Jwt__Secret=dev-only-jwt-signing-key-32-bytes-minimum-length-please
Jwt__RoleClaim=role

Razorpay__KeyId=rzp_test_dev_placeholder
Razorpay__KeySecret=dev-only-razorpay-secret

Gmail__User=dev-noreply@placementpro.local
Gmail__AppPassword=dev-only-gmail-app-password


# --- Brevo (transactional email — OTP delivery) ---
Brevo__ApiKey=xkeysib-REPLACE-with-your-brevo-v3-api-key
Brevo__SenderEmail=noreply@yourdomain.com
Brevo__SenderName=Placement Pro
# Optional: numeric Brevo template id. Leave blank to use the built-in HTML fallback.
Brevo__OtpTemplateId=

# --- OTP policy (registration email verification) ---
Otp__CodeLength=6
Otp__ExpirySeconds=600
Otp__MaxAttempts=5
Otp__ResendCooldownSeconds=60
# HMAC key used to hash stored OTPs. Minimum 32 characters. Rotate on incident, never commit.
Otp__HashKey=REPLACE-with-a-random-32-plus-character-server-only-secret

Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://192.168.1.5:3000

RateLimit__PermitLimit=100
RateLimit__WindowSeconds=60

SubscriptionSeed__Enabled=true
SubscriptionSeed__Plans__0__Code=monthly-pro
SubscriptionSeed__Plans__0__Name=Monthly (Pro)
SubscriptionSeed__Plans__0__Price=199
SubscriptionSeed__Plans__0__IntervalUnit=Month
SubscriptionSeed__Plans__0__IntervalCount=1

SubscriptionSeed__Plans__1__Code=quarterly-pro
SubscriptionSeed__Plans__1__Name=Quarterly (Pro)
SubscriptionSeed__Plans__1__Price=499
SubscriptionSeed__Plans__1__IntervalUnit=Month
SubscriptionSeed__Plans__1__IntervalCount=3

SubscriptionSeed__Plans__2__Code=half-yearly-pro
SubscriptionSeed__Plans__2__Name=Half-Yearly (Pro)
SubscriptionSeed__Plans__2__Price=999
SubscriptionSeed__Plans__2__IntervalUnit=Month
SubscriptionSeed__Plans__2__IntervalCount=6

SubscriptionSeed__Plans__3__Code=yearly-premium
SubscriptionSeed__Plans__3__Name=Yearly (Premium)
SubscriptionSeed__Plans__3__Price=1999
SubscriptionSeed__Plans__3__IntervalUnit=Month
SubscriptionSeed__Plans__3__IntervalCount=12
