# =============================================================================
#  CareerPlatform API — application.properties-style configuration
# =============================================================================
#  Loaded at startup by DotNetEnv before IConfiguration is built, so every
#  key here overrides appsettings*.json. Nested settings use "__" (double
#  underscore) — .NET's standard env-var convention.
#
#  Copy this file to `.env` in the same directory and fill in real values.
#  `.env` is gitignored; `.env.example` is committed as the source of truth.
#
#  Precedence (highest last):
#    appsettings.json < appsettings.<Env>.json < .env < real env vars
# =============================================================================

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5215

# --- Database ---
# Option A: Postgres URI (Supabase / Heroku style). Converted to Npgsql form at boot.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Option B: Npgsql keyword form (overrides DATABASE_URL if set).
# ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=postgres;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true

ConnectionStrings__Redis=disabled

# TLS certificate validation for the DB connection is ON by default (secure). Set to true ONLY
# when the managed Postgres CA is not in the container/host trust store (e.g. some local setups).
DATABASE_TRUST_SERVER_CERTIFICATE=false

# Postgres schema the app confines itself to (Npgsql `Search Path`). Leave blank
# for `public` when the database belongs to this app alone.
#
# Set it when the database is SHARED with another application: several table names
# in schema.sql are generic (Transactions, Notifications, Certificates, Sections,
# SupportTickets, PlacementCompanies) and may already exist there with a different
# shape. Because schema.sql uses CREATE TABLE IF NOT EXISTS, a collision is silent
# — the table is skipped and the app then binds to the foreign table and fails on
# its first query. Apply schema.sql into the same schema you name here:
#   CREATE SCHEMA IF NOT EXISTS careerplatform;
#   SET search_path TO careerplatform;   -- then run schema.sql
# DATABASE_SCHEMA=careerplatform

# --- JWT (Supabase) ---
Jwt__Issuer=https://YOUR-PROJECT.supabase.co/auth/v1
Jwt__Audience=authenticated
Jwt__Secret=REPLACE-with-a-32+char-signing-secret
Jwt__RoleClaim=role

# --- Razorpay ---
Razorpay__KeyId=rzp_test_xxxxxxxxxxxxxx
Razorpay__KeySecret=REPLACE-with-razorpay-key-secret

# --- Email (Gmail app password) ---
Gmail__User=noreply@yourdomain.com
Gmail__AppPassword=xxxx xxxx xxxx xxxx


# --- Brevo (transactional email — OTP delivery) ---
Brevo__ApiKey=xkeysib-REPLACE-with-your-brevo-v3-api-key
Brevo__SenderEmail=noreply@yourdomain.com
Brevo__SenderName=Placement Pro
# Optional: numeric Brevo template id. Leave blank to use the built-in HTML fallback.
Brevo__OtpTemplateId=

# --- OTP policy (registration email verification) ---
Otp__CodeLength=6
Otp__ExpirySeconds=600
Otp__MaxAttempts=5
Otp__ResendCooldownSeconds=60
# HMAC key used to hash stored OTPs. Minimum 32 characters. Rotate on incident, never commit.
Otp__HashKey=REPLACE-with-a-random-32-plus-character-server-only-secret

# --- CORS (indexed list — one origin per index) ---
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://192.168.1.5:3000
# Cors__AllowedOrigins__2=https://your-frontend.com

# --- Rate limiting ---
RateLimit__PermitLimit=100
RateLimit__WindowSeconds=60

# --- Subscription catalog seed (first boot only) ---
# NOTE: pricing is now owned by backend/application.properties, which reconciles the
# SubscriptionPlans table on every boot and whenever the file changes. These keys only
# bootstrap an empty database; edit application.properties to change what students pay.
# Each plan is an indexed record. Prices in whole INR rupees.
SubscriptionSeed__Enabled=true
SubscriptionSeed__Plans__0__Code=monthly-pro
SubscriptionSeed__Plans__0__Name=Monthly (Pro)
SubscriptionSeed__Plans__0__Price=199
SubscriptionSeed__Plans__0__IntervalUnit=Month
SubscriptionSeed__Plans__0__IntervalCount=1

SubscriptionSeed__Plans__1__Code=quarterly-pro
SubscriptionSeed__Plans__1__Name=Quarterly (Pro)
SubscriptionSeed__Plans__1__Price=499
SubscriptionSeed__Plans__1__IntervalUnit=Month
SubscriptionSeed__Plans__1__IntervalCount=3

SubscriptionSeed__Plans__2__Code=half-yearly-pro
SubscriptionSeed__Plans__2__Name=Half-Yearly (Pro)
SubscriptionSeed__Plans__2__Price=999
SubscriptionSeed__Plans__2__IntervalUnit=Month
SubscriptionSeed__Plans__2__IntervalCount=6

SubscriptionSeed__Plans__3__Code=yearly-premium
SubscriptionSeed__Plans__3__Name=Yearly (Premium)
SubscriptionSeed__Plans__3__Price=1999
SubscriptionSeed__Plans__3__IntervalUnit=Month
SubscriptionSeed__Plans__3__IntervalCount=12

# --- Course catalog seed (optional; real prices live in the Courses table and are admin-editable) ---
# Each entry is an indexed record identified by Slug (natural key). Only seeded if the slug is absent.
CourseSeed__Enabled=false
# CourseSeed__Courses__0__Slug=full-stack-bootcamp
# CourseSeed__Courses__0__Title=Full-Stack Bootcamp
# CourseSeed__Courses__0__Price=2999
# CourseSeed__Courses__0__Currency=INR
# CourseSeed__Courses__0__IsPublished=true

# --- Code execution sandbox (assessment coding questions) ---
# Full documentation and the language catalog live in backend/application.properties,
# which already points at the Piston container from the repo-root docker-compose.yml
# (http://localhost:2000). Only set these here to override that file per environment.
# CodeExecution__Provider=Disabled
# CodeExecution__BaseUrl=https://piston.internal.example.com

# --- Session cookie ---
# Defaults live in appsettings.{Environment}.json: Lax/insecure in Development
# (localhost:3000 → localhost:5215 is same-site), None+Secure everywhere else
# because the deployed frontend is on a different site from the API.
# Override only if your topology differs.
# AuthCookie__SameSite=Lax
# AuthCookie__AlwaysSecure=false
# Share the cookie across subdomains of one parent domain. Leave unset for a
# host-only cookie; it cannot send the cookie to an unrelated site.
# AuthCookie__Domain=.your-domain.com
