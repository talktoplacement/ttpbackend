## ============================================================
##  .gitignore for the CareerPlatform.Api backend (.NET 8)
##  Anything listed here is excluded from git add / commit / push.
## ============================================================

## ---- Build output (per-project) ----
# These are regenerated by `dotnet build`; never commit them.
bin/
obj/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
artifacts/
publish/
[Pp]ublish/
*.dll
*.exe
*.pdb

## ---- Restore / package artifacts ----
project.lock.json
project.assets.json
*.nuget.props
*.nuget.targets
packages/
.nuget/
*.nupkg
*.snupkg

## ---- IDE / editor ----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
.kiro/

## ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

## ---- Secrets & environment (NEVER push) ----
# Real secrets belong in user-secrets / env vars / a vault, not the repo.
appsettings.*.local.json
*.secrets.json
secrets.json
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem

## ---- Local databases (Postgres is the real store; these are strays) ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

## ---- Logs ----
logs/
*.log

## ---- Test results / coverage ----
[Tt]est[Rr]esult*/
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

## ---- Misc ----
*.tmp
*.bak
*.cache
_ReSharper*/
